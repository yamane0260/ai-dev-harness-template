#!/usr/bin/env python3
"""Append one sanitized agent action event for host/wrapper integrations."""

from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib.assurance_core import EVENT_TYPES, find_repo_root
from lib.agent_trace import SAFE_ID, sensitive_target


def safe_target(value: str) -> str:
    if sensitive_target(value):
        raise ValueError("target is invalid or appears to contain a credential payload")
    return value


def safe_id(value: str, name: str) -> str:
    if not SAFE_ID.fullmatch(value):
        raise ValueError(f"{name} must be 8-128 safe identifier characters")
    return value


def safe_actor(value: str) -> str:
    if not value or len(value) > 128 or "\n" in value or "\r" in value:
        raise ValueError("actor must be 1-128 characters on one line")
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--actor", required=True)
    parser.add_argument("--action", required=True, choices=sorted(EVENT_TYPES))
    parser.add_argument("--target", required=True)
    parser.add_argument(
        "--outcome", choices=("success", "failure", "denied", "unknown"), required=True
    )
    parser.add_argument(
        "--impact", choices=("routine", "sensitive", "external"), default="routine"
    )
    parser.add_argument(
        "--authorization",
        choices=("user-request", "repository-policy", "tool-policy", "human-approval", "unknown"),
        default="unknown",
    )
    parser.add_argument(
        "--capture-source",
        choices=("host", "tool-adapter", "wrapper", "manual"),
        default="manual",
    )
    parser.add_argument("--trace-id", default=os.environ.get("HARNESS_TRACE_ID"))
    parser.add_argument("--span-id")
    parser.add_argument("--parent-span-id")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()

    if args.impact == "external" and args.authorization == "unknown":
        parser.error("external events require an explicit authorization source")

    root = find_repo_root(Path.cwd())
    trace_id = safe_id(args.trace_id or uuid.uuid4().hex, "trace_id")
    span_id = safe_id(args.span_id or uuid.uuid4().hex[:16], "span_id")
    parent_span_id = safe_id(args.parent_span_id, "parent_span_id") if args.parent_span_id else None
    actor = safe_actor(args.actor)
    target = safe_target(args.target)
    output = args.output or root / ".ai-artifacts" / "traces" / f"{trace_id}.jsonl"
    if not output.is_absolute():
        output = root / output
    output.parent.mkdir(parents=True, exist_ok=True)

    event = {
        "schema_version": "1.0",
        "timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "trace_id": trace_id,
        "span_id": span_id,
        "parent_span_id": parent_span_id,
        "actor": actor,
        "action_type": args.action,
        "target": target,
        "outcome": args.outcome,
        "impact": args.impact,
        "authorization_source": args.authorization,
        "capture_source": args.capture_source,
        "redaction": {"payload_recorded": False, "secrets_recorded": False},
    }
    line = json.dumps(event, ensure_ascii=False, separators=(",", ":")) + "\n"
    descriptor = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(descriptor, line.encode("utf-8"))
    finally:
        os.close(descriptor)
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
