#!/usr/bin/env python3
"""Validate sanitized JSONL agent events and optionally write a compact summary."""

from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib.assurance_core import EVENT_TYPES, dump_json
from lib.agent_trace import SAFE_ID, sensitive_target


REQUIRED = {
    "schema_version",
    "timestamp",
    "trace_id",
    "span_id",
    "parent_span_id",
    "actor",
    "action_type",
    "target",
    "outcome",
    "impact",
    "authorization_source",
    "capture_source",
    "redaction",
}
def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", type=Path)
    parser.add_argument("--summary", type=Path)
    args = parser.parse_args()

    errors = []
    events = []
    seen_spans = set()
    with args.trace.open("r", encoding="utf-8") as handle:
        for line_number, raw_line in enumerate(handle, start=1):
            try:
                event = json.loads(raw_line)
            except json.JSONDecodeError as exc:
                errors.append(f"line {line_number}: invalid JSON: {exc}")
                continue
            if not isinstance(event, dict):
                errors.append(f"line {line_number}: event must be an object")
                continue
            missing = REQUIRED - set(event)
            extra = set(event) - REQUIRED
            if missing:
                errors.append(f"line {line_number}: missing fields: {sorted(missing)}")
            if extra:
                errors.append(f"line {line_number}: unknown fields: {sorted(extra)}")
            if event.get("schema_version") != "1.0":
                errors.append(f"line {line_number}: unsupported schema_version")
            if event.get("action_type") not in EVENT_TYPES:
                errors.append(f"line {line_number}: unsupported action_type")
            if event.get("outcome") not in {"success", "failure", "denied", "unknown"}:
                errors.append(f"line {line_number}: invalid outcome")
            if event.get("impact") not in {"routine", "sensitive", "external"}:
                errors.append(f"line {line_number}: invalid impact")
            if event.get("authorization_source") not in {
                "user-request",
                "repository-policy",
                "tool-policy",
                "human-approval",
                "unknown",
            }:
                errors.append(f"line {line_number}: invalid authorization_source")
            if event.get("capture_source") not in {"host", "tool-adapter", "wrapper", "manual"}:
                errors.append(f"line {line_number}: invalid capture_source")
            for field in ("trace_id", "span_id"):
                value = event.get(field)
                if not isinstance(value, str) or not SAFE_ID.fullmatch(value):
                    errors.append(f"line {line_number}: invalid {field}")
            parent_span_id = event.get("parent_span_id")
            if parent_span_id is not None and (
                not isinstance(parent_span_id, str) or not SAFE_ID.fullmatch(parent_span_id)
            ):
                errors.append(f"line {line_number}: invalid parent_span_id")
            actor = event.get("actor")
            if (
                not isinstance(actor, str)
                or not actor
                or len(actor) > 128
                or "\n" in actor
                or "\r" in actor
            ):
                errors.append(f"line {line_number}: invalid actor")
            if event.get("impact") == "external" and event.get("authorization_source") == "unknown":
                errors.append(f"line {line_number}: external event needs an authorization source")
            redaction = event.get("redaction")
            if redaction != {"payload_recorded": False, "secrets_recorded": False}:
                errors.append(f"line {line_number}: unsafe or invalid redaction declaration")
            try:
                parsed_timestamp = datetime.fromisoformat(
                    str(event.get("timestamp", "")).replace("Z", "+00:00")
                )
                if parsed_timestamp.tzinfo is None:
                    raise ValueError("timezone missing")
            except ValueError:
                errors.append(f"line {line_number}: invalid timestamp")
            target = event.get("target")
            if not isinstance(target, str) or sensitive_target(target):
                errors.append(f"line {line_number}: unsafe or invalid target")
            span_id = event.get("span_id")
            if span_id in seen_spans:
                errors.append(f"line {line_number}: duplicate span_id")
            seen_spans.add(span_id)
            events.append(event)

    summary = {
        "schema_version": "1.0",
        "coverage": "declared-events-only",
        "event_count": len(events),
        "action_counts": dict(
            sorted(Counter(str(e.get("action_type") or "<missing>") for e in events).items())
        ),
        "outcome_counts": dict(
            sorted(Counter(str(e.get("outcome") or "<missing>") for e in events).items())
        ),
        "capture_source_counts": dict(
            sorted(
                Counter(str(e.get("capture_source") or "<missing>") for e in events).items()
            )
        ),
        "high_impact_events": [
            {
                "timestamp": event.get("timestamp"),
                "action_type": event.get("action_type"),
                "target": event.get("target"),
                "outcome": event.get("outcome"),
                "authorization_source": event.get("authorization_source"),
            }
            for event in events
            if event.get("impact") in {"sensitive", "external"}
        ],
        "errors": errors,
    }
    if args.summary:
        dump_json(summary, args.summary)
    if errors:
        for error in errors:
            print(f"FAIL {error}", file=sys.stderr)
        return 1
    print(f"PASS agent trace ({len(events)} declared events; coverage is not completeness)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
