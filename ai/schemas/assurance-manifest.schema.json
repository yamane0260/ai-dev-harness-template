{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev-harness/assurance-manifest.schema.json",
  "title": "AI Dev Harness assurance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change",
    "requirements",
    "claims",
    "human_checks_file",
    "references"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "risk", "knowledge_impact", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^CHG-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["green", "yellow", "red"] },
        "knowledge_impact": { "enum": ["none", "low", "material", "critical"] },
        "status": { "enum": ["draft", "active", "ready", "released"] }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "criticality",
          "requirement_ids",
          "scope",
          "evidence_requirements",
          "human_check_ids",
          "residual_uncertainty"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "criticality": { "enum": ["must", "should"] },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["components", "paths"],
            "properties": {
              "components": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "paths": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "evidence_requirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidenceRequirement" }
          },
          "human_check_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "residual_uncertainty": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_checks_file": { "type": "string", "minLength": 1 },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specs", "decisions", "concepts", "runbooks"],
      "properties": {
        "specs": { "$ref": "#/$defs/pathList" },
        "decisions": { "$ref": "#/$defs/pathList" },
        "concepts": { "$ref": "#/$defs/pathList" },
        "runbooks": { "$ref": "#/$defs/pathList" }
      }
    },
    "agent_trace_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "event_types", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "event_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agentEventType" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^EVR-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "enum": ["gate", "ai-review"] },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "gate": {
          "enum": [
            "typecheck",
            "lint",
            "unit",
            "integration",
            "e2e",
            "build",
            "security",
            "dependency",
            "architecture",
            "visual"
          ]
        },
        "locator": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "gate" } } },
          "then": { "required": ["gate", "locator"] }
        },
        {
          "if": { "properties": { "kind": { "const": "ai-review" } } },
          "then": { "required": ["artifact"] }
        }
      ]
    },
    "agentEventType": {
      "enum": [
        "file.read",
        "file.write",
        "shell.execute",
        "network.request",
        "tool.call",
        "credential.access",
        "git.push",
        "release.deploy",
        "subagent.invoke"
      ]
    }
  }
}
