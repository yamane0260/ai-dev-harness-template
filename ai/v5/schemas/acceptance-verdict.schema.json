{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev-harness/v5/acceptance-verdict.schema.json",
  "title": "V5 Acceptance Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "contractHash",
    "repository",
    "independentContext",
    "holdout",
    "acceptance",
    "invariants",
    "baseline",
    "unresolved"
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "contractHash": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object"
    },
    "independentContext": {
      "type": "boolean"
    },
    "holdout": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "used",
            "not_applicable",
            "not_used"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "baseline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}