{
  "schema_version": "1.0",
  "id": "high-assurance",
  "description": "Prefer stronger independent review, durable assurance, explicit human checks, and conservative release handling for high-consequence work.",
  "objectives": {
    "delivery_speed": "low",
    "autonomy": "medium",
    "human_understanding": "high",
    "handoff_depth": "high",
    "human_attention": "high",
    "context_efficiency": "medium"
  },
  "constraints": {
    "risk_policy": {
      "minimum": "YELLOW",
      "allow_below_deterministic_floor": false
    },
    "required_capabilities": [
      {
        "capability": "risk.floor",
        "contract_version": 1,
        "when": "always"
      },
      {
        "capability": "profile.resolve",
        "contract_version": 1,
        "when": "always"
      },
      {
        "capability": "verification.run",
        "contract_version": 1,
        "when": "selected"
      },
      {
        "capability": "review.verification",
        "contract_version": 1,
        "when": "risk-yellow-or-higher"
      },
      {
        "capability": "assurance.evaluate",
        "contract_version": 1,
        "when": "risk-yellow-or-higher"
      },
      {
        "capability": "release.evaluate",
        "contract_version": 1,
        "when": "release"
      }
    ],
    "release": {
      "require_assurance_for": ["YELLOW", "RED"],
      "require_human_go_no_go_for_red": true
    }
  },
  "understanding": {
    "requirement": "MAINTAINER",
    "knowledge_impact_policy": "durable-on-material",
    "fresh_legibility_review": "material"
  },
  "context_budget": {
    "strategy": "generous",
    "parent_tokens": 52000,
    "plugin_instruction_tokens": 12000,
    "tool_result_tokens": 14000,
    "child_context_isolation_preferred": true,
    "compaction_allowed": true
  },
  "routing": {
    "prefer_fresh_context_reviews": true,
    "prefer_structured_parent_outputs": true,
    "allow_advisory_capabilities_to_be_skipped": false
  }
}
