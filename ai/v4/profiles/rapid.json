{
  "schema_version": "1.0",
  "id": "rapid",
  "description": "Prefer fast autonomous delivery and low human/context overhead while preserving all kernel, risk, Claim, quality-impact, and project constraints.",
  "objectives": {
    "delivery_speed": "critical",
    "autonomy": "high",
    "human_understanding": "low",
    "handoff_depth": "low",
    "human_attention": "minimize",
    "context_efficiency": "critical"
  },
  "constraints": {
    "risk_policy": {
      "allow_below_deterministic_floor": false
    },
    "required_capabilities": [
      {
        "capability": "risk.floor",
        "contract_version": 1,
        "when": "always"
      },
      {
        "capability": "profile.resolve",
        "contract_version": 1,
        "when": "always"
      },
      {
        "capability": "verification.run",
        "contract_version": 1,
        "when": "selected"
      }
    ],
    "release": {
      "require_assurance_for": ["YELLOW", "RED"],
      "require_human_go_no_go_for_red": true
    }
  },
  "understanding": {
    "requirement": "NONE",
    "knowledge_impact_policy": "durable-on-material",
    "fresh_legibility_review": "critical"
  },
  "context_budget": {
    "strategy": "strict",
    "parent_tokens": 24000,
    "plugin_instruction_tokens": 5000,
    "tool_result_tokens": 6000,
    "child_context_isolation_preferred": true,
    "compaction_allowed": true
  },
  "routing": {
    "prefer_fresh_context_reviews": true,
    "prefer_structured_parent_outputs": true,
    "allow_advisory_capabilities_to_be_skipped": true
  }
}
